# ==========================================
# CONFIGURACIÓN DEL BOT DE TIKTOK STICKERS
# ==========================================

# Número de WhatsApp del propietario (con prefijo de país, sin espacios ni '+')
# Ejemplo para España (+34): 34XXXXXXXXX
OWNER_NUMBER=34XXXXXXXXX

# Retardo en milisegundos entre cada envío de sticker (evita spam y bloqueos en WhatsApp)
# Recomendado: 1000 ms (1 segundo)
STICKER_DELAY_MS=1000

# Límite máximo de registros en la base de datos de historial
MAX_DB_ENTRIES=5000

# Intervalo en milisegundos para guardar cookies/sesión de TikTok en disco
TIKTOK_SAVE_INTERVAL_MS=60000

# Capacidad máxima de stickers pendientes en memoria
MAX_COLA_STICKERS=100

# Número máximo de reintentos ante fallo de envío en WhatsApp
MAX_REINTENTOS_ENVIO=2

# Ruta personalizada al ejecutable de Google Chrome para WhatsApp Web (opcional)
# Si se deja vacío, busca Chrome en la ruta por defecto del SO (macOS/Windows/Linux) o usa el Chromium de Puppeteer
CHROME_PATH=
